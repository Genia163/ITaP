def check_task1(user_func):
    """Проверка Задания 1: filter_even_squares"""
    try:
        # Тест 1: Базовый
        assert user_func([1, 2, 3, 4, 5, 6]) == [4, 16, 36], "Ошибка на базовом списке [1, 2, 3, 4, 5, 6]"
        
        # Тест 2: Нет четных чисел
        assert user_func([1, 3, 5]) == [], "Для списка без четных чисел должен возвращаться []"
        
        # Тест 3: Краевые случаи (отрицательные числа и ноль)
        assert user_func([-4, -3, 0]) == [16, 0], "Ошибка при работе с отрицательными числами или нулем"
        
        print("✅ Задание 1 пройдено успешно!")
        
    except AssertionError as e:
        print(f"❌ Тест не пройден: {e}")
    except Exception as e:
        print(f"⚠️ Ошибка при выполнении функции: {type(e).__name__}: {e}")

